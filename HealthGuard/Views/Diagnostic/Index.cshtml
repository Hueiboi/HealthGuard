@{
    ViewData["Title"] = "Lựa chọn triệu chứng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .wizard-container {
            max-width: 850px;
            margin: 0 auto;
        }

        .wizard-subtitle {
            color: #2c6fb0;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .wizard-title {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 15px;
            color: var(--text-dark);
        }

        .wizard-desc {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        /* Thanh progress chuẩn */
        .progress-track {
            height: 6px;
            background-color: #e5e9f2;
            border-radius: 10px;
            margin-bottom: 30px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background-color: #346cb0;
            width: 33%;
            border-radius: 10px;
            transition: width 0.4s ease;
        }

        .symptom-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 30px;
            border: 1px solid #e2e8f0;
            margin-bottom: 30px;
        }

        .search-box {
            background-color: #f4f6f8;
            border-radius: 12px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            margin-bottom: 10px;
            border: 1px solid transparent;
            transition: 0.2s;
        }

            .search-box:focus-within {
                border-color: #3b82f6;
                background-color: #fff;
                box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
            }

            .search-box input {
                border: none;
                background: transparent;
                width: 100%;
                outline: none;
                margin-left: 10px;
                font-size: 0.95rem;
            }

        .category-title {
            font-size: 1.1rem;
            font-weight: 800;
            color: #0d47a1;
            margin-top: 30px;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #e2eafc;
            display: flex;
            align-items: center;
        }

            .category-title i {
                margin-right: 10px;
                color: #3b82f6;
                font-size: 1.2rem;
            }

        .symptom-category {
            margin-bottom: 20px;
        }

        .symptoms-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 12px;
        }

        .symptom-chip {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            cursor: pointer;
            transition: 0.2s;
            font-weight: 600;
            color: #334155;
            font-size: 0.95rem;
        }

            .symptom-chip:hover {
                background-color: #f1f5f9;
                border-color: #cbd5e1;
            }

            .symptom-chip.selected {
                background-color: #eff6ff;
                border-color: #3b82f6;
                color: #1e40af;
                box-shadow: 0 4px 10px rgba(59, 130, 246, 0.1);
            }

        .icon-circle {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-size: 1.1rem;
            color: #94a3b8;
            transition: 0.2s;
        }

        .symptom-chip.selected .icon-circle {
            background-color: #3b82f6;
            color: white;
        }

        .action-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-cancel {
            background: none;
            border: none;
            color: #346cb0;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

            .btn-cancel:hover {
                color: #0d47a1;
            }

        .btn-continue {
            background-color: #0d47a1;
            color: white;
            border: none;
            border-radius: 30px;
            padding: 12px 28px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            transition: 0.2s;
        }

            .btn-continue:hover {
                background-color: #1a4d8c;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(13, 71, 161, 0.2);
            }

            .btn-continue i {
                margin-left: 8px;
            }
    </style>
}

<div class="wizard-container">
    <div class="wizard-subtitle">CÔNG CỤ CHẨN ĐOÁN &bull; BƯỚC 1/3</div>
    <h1 class="wizard-title">Lựa chọn triệu chứng</h1>
    <p class="wizard-desc">Để giúp chúng tôi hiểu rõ hơn về tình trạng của bạn, vui lòng chọn tất cả các triệu chứng mà bạn đang gặp phải.</p>

    <div class="progress-track"><div class="progress-fill"></div></div>

    <div class="symptom-card">
        <div class="search-box">
            <i class="bi bi-search text-muted"></i>
            <input type="text" id="searchInput" placeholder="Tìm kiếm triệu chứng nhanh (Ví dụ: Ho, Đau bụng)...">
        </div>
        <div id="symptomGrid">
            <div class="text-primary mt-4"><i class="spinner-border spinner-border-sm me-2"></i> Đang tải và phân nhóm dữ liệu triệu chứng...</div>
        </div>
    </div>

    <div class="action-footer">
        <a asp-controller="Home" asp-action="Index" class="btn-cancel">
            <i class="bi bi-arrow-left me-1"></i> Hủy bỏ
        </a>
        <button class="btn-continue" onclick="submitSymptoms()">
            Tiếp tục nhập chi tiết <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        let allSymptoms = [];
        document.addEventListener("DOMContentLoaded", async () => {
            try {
                const response = await fetch('/api/patient/diagnose/symptoms');
                allSymptoms = await response.json();
                renderSymptoms(allSymptoms);
            } catch (err) {
                document.getElementById('symptomGrid').innerHTML = "<div class='text-danger mt-3'><i class='bi bi-exclamation-triangle-fill me-2'></i> Không thể tải dữ liệu triệu chứng.</div>";
            }

            document.getElementById('searchInput').addEventListener('input', function(e) {
                const keyword = e.target.value.toLowerCase().trim();
                filterSymptoms(keyword);
            });
        });

        function getCategory(symptomName) {
            const lowerName = symptomName.toLowerCase();
            if (/(ho |ho|thở|họng|mũi|đờm|khò khè|hắt hơi|ngực)/.test(lowerName)) return { name: "Hô hấp & Tai mũi họng", icon: "bi-lungs-fill" };
            if (/(bụng|nôn|tiêu chảy|táo bón|ợ|phân|chán ăn|thượng vị|tiêu hóa)/.test(lowerName)) return { name: "Tiêu hóa & Ổ bụng", icon: "bi-cup-hot-fill" };
            if (/(khớp|cơ|vai|gáy|lưng|tê|chân tay|nhức mỏi)/.test(lowerName)) return { name: "Cơ Xương Khớp", icon: "bi-universal-access" };
            if (/(đầu|chóng mặt|sốt|lạnh|mồ hôi|mệt mỏi|mất ngủ|co giật|ngất|thần kinh)/.test(lowerName)) return { name: "Thần kinh & Toàn thân", icon: "bi-person-arms-up" };
            if (/(ban|ngứa|mề đay|mụn|da|vàng da)/.test(lowerName)) return { name: "Da liễu", icon: "bi-stars" };
            return { name: "Triệu chứng khác", icon: "bi-heart-pulse-fill" };
        }

        function renderSymptoms(data) {
            const grid = document.getElementById('symptomGrid');
            grid.innerHTML = "";
            const grouped = {};
            data.forEach(s => {
                let catInfo = getCategory(s.symptomName);
                if(!grouped[catInfo.name]) grouped[catInfo.name] = { items: [], icon: catInfo.icon };
                grouped[catInfo.name].items.push(s);
            });

            for (const [catName, catData] of Object.entries(grouped)) {
                let catDiv = document.createElement('div');
                catDiv.className = 'symptom-category';
                catDiv.innerHTML = `<h4 class="category-title"><i class="bi ${catData.icon}"></i> ${catName}</h4>`;
                let gridDiv = document.createElement('div');
                gridDiv.className = 'symptoms-grid';

                catData.items.forEach(s => {
                    const chip = document.createElement('div');
                    chip.className = 'symptom-chip';
                    chip.setAttribute('data-id', s.id);
                    chip.setAttribute('data-name', s.symptomName);
                    chip.innerHTML = `<div class="icon-circle"><i class="bi bi-plus-lg"></i></div><span>${s.symptomName}</span>`;

                    chip.onclick = function() {
                        this.classList.toggle('selected');
                        const icon = this.querySelector('.icon-circle i');
                        if(this.classList.contains('selected')) {
                            icon.classList.replace('bi-plus-lg', 'bi-check-lg');
                        } else {
                            icon.classList.replace('bi-check-lg', 'bi-plus-lg');
                        }
                    };
                    gridDiv.appendChild(chip);
                });
                catDiv.appendChild(gridDiv);
                grid.appendChild(catDiv);
            }
            restoreSelectedSymptoms();
        }

        function filterSymptoms(keyword) {
            document.querySelectorAll('.symptom-category').forEach(category => {
                let hasVisible = false;
                category.querySelectorAll('.symptom-chip').forEach(chip => {
                    const name = chip.getAttribute('data-name').toLowerCase();
                    if (name.includes(keyword)) {
                        chip.style.display = 'flex'; hasVisible = true;
                    } else {
                        chip.style.display = 'none';
                    }
                });
                category.style.display = hasVisible ? 'block' : 'none';
            });
        }

        function restoreSelectedSymptoms() {
            const savedData = sessionStorage.getItem('healthGuard_Symptoms');
            if (savedData) {
                JSON.parse(savedData).forEach(s => {
                    const chip = document.querySelector(`.symptom-chip[data-id="${s.id}"]`);
                    if (chip) {
                        chip.classList.add('selected');
                        chip.querySelector('.icon-circle i').classList.replace('bi-plus-lg', 'bi-check-lg');
                    }
                });
            }
        }

        function showErrorToast(message) {
            const existingToast = document.getElementById('errorToast');
            if (existingToast) existingToast.remove();
            const toast = document.createElement('div');
            toast.id = 'errorToast';
            toast.className = 'alert alert-danger shadow-lg position-fixed start-50 translate-middle-x';
            toast.style.cssText = 'top: 20px; z-index: 9999; border-radius: 12px; min-width: 300px; text-align: center; transition: opacity 0.5s ease-out;';
            toast.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-2"></i> ${message}`;
            document.body.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 500); }, 3000);
        }

        function submitSymptoms() {
            const selected = document.querySelectorAll('.symptom-chip.selected');
            if(selected.length === 0) {
                showErrorToast("Vui lòng chọn ít nhất 1 triệu chứng để tiếp tục!");
                return;
            }
            const selectedData = Array.from(selected).map(c => {
                return { id: c.getAttribute('data-id'), name: c.querySelector('span').innerText };
            });
            sessionStorage.setItem('healthGuard_Symptoms', JSON.stringify(selectedData));
            window.location.href = '@Url.Action("Details", "Diagnostic")';
        }
    </script>
}