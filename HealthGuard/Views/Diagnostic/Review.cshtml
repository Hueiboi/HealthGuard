@{
    ViewData["Title"] = "Kết quả chẩn đoán - HealthGuard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .review-container {
            max-width: 1100px;
            margin: 40px auto;
            width: 100%;
        }

        .wizard-subtitle {
            color: #2c6fb0;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .wizard-title {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 15px;
            color: var(--text-dark);
        }

        .wizard-desc {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .progress-track {
            height: 6px;
            background-color: #e5e9f2;
            border-radius: 10px;
            margin-bottom: 40px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background-color: #346cb0;
            border-radius: 10px;
            width: 100%;
            transition: width 0.4s ease;
        }

        .top-bar {
            display: flex;
            justify-content: flex-end;
            gap: 15px;
            margin-bottom: 30px;
        }

        .insights-grid {
            display: grid;
            grid-template-columns: 1.3fr 1fr;
            gap: 40px;
            align-items: start;
        }

        .primary-disease-name {
            font-size: 2.2rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 5px;
            line-height: 1.3;
            display: block;
        }

        .primary-prob {
            color: #0d47a1;
            font-size: 2.5rem;
            font-weight: 900;
            display: block;
            margin-bottom: 20px;
        }

        .primary-desc {
            color: #475569;
            font-size: 1.05rem;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .action-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 25px;
        }

        .action-title {
            font-size: 0.85rem;
            font-weight: 800;
            color: #1e293b;
            text-transform: uppercase;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .action-content {
            font-size: 0.95rem;
            color: #475569;
            line-height: 1.6;
            margin: 0;
        }

        .btn-feedback {
            background: #eff6ff;
            color: #0d47a1;
            border: 1px dashed #93c5fd;
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            width: 100%;
            transition: 0.2s;
            font-size: 0.95rem;
        }

            .btn-feedback:hover {
                background: #e0e7ff;
                border-style: solid;
            }

        .secondary-card {
            background: white;
            border-radius: 16px;
            padding: 20px 25px;
            border: 1px solid #e2e8f0;
            margin-bottom: 15px;
            transition: 0.2s;
            box-shadow: 0 4px 10px rgba(0,0,0,0.01);
        }

            .secondary-card:hover {
                border-color: #cbd5e1;
                box-shadow: 0 8px 20px rgba(0,0,0,0.04);
            }

        .sec-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .sec-title {
            font-weight: 800;
            font-size: 1.1rem;
            color: #1e293b;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sec-prob {
            font-weight: 900;
            color: #0d47a1;
            font-size: 1.2rem;
        }

        .sec-desc {
            color: #64748b;
            font-size: 0.9rem;
            line-height: 1.5;
            margin: 0;
        }
    </style>
}

<div class="review-container">
    <div class="wizard-subtitle">CÔNG CỤ CHẨN ĐOÁN &bull; BƯỚC 3/3</div>
    <h1 class="wizard-title">Kết quả phân tích</h1>
    <p class="wizard-desc">Trí tuệ nhân tạo đã hoàn tất quá trình so khớp và đánh giá các triệu chứng của bạn.</p>

    <div class="progress-track"><div class="progress-fill"></div></div>

    <div id="loadingStatus" class="text-center" style="padding: 100px 0;">
        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
        <h3 class="fw-bold text-dark">AI đang phân tích triệu chứng...</h3>
        <p class="text-muted">Hệ thống đang thực hiện chuẩn hóa và tính toán xác suất bệnh lý.</p>
    </div>

    <div id="resultWrapper" style="display: none;">
        <div class="top-bar">
            <a asp-controller="Diagnostic" asp-action="History" class="btn btn-outline-primary fw-bold" style="border-radius: 20px; padding: 8px 24px;"><i class="bi bi-clock-history me-2"></i> Lịch sử</a>
            <button class="btn btn-primary fw-bold" onclick="window.print()" style="border-radius: 20px; padding: 8px 24px;"><i class="bi bi-printer me-2"></i> Lưu kết quả</button>
        </div>

        <div class="insights-grid">
            <div class="primary-column">
                <h1 class="primary-disease-name" id="primaryDiseaseName">--</h1>
                <span class="primary-prob" id="primaryProbability"></span>

                <p class="primary-desc" id="primaryDesc">--</p>

                <div class="action-box">
                    <div class="action-title"><i class="bi bi-shield-check text-primary fs-5"></i> HÀNH ĐỘNG KHUYẾN NGHỊ</div>
                    <p class="action-content" id="primaryTreatment">--</p>
                </div>

                <button class="btn w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#feedbackModal" style="background: #eff6ff; color: #0d47a1; border: 1px dashed #93c5fd; padding: 14px; border-radius: 12px;">
                    <i class="bi bi-chat-square-text me-2"></i> Đánh giá trải nghiệm chẩn đoán
                </button>
            </div>

            <div class="secondary-column" id="secondaryList"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="feedbackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 24px; border: none;">
            <div class="modal-body" style="padding: 40px;">
                <h3 class="fw-bold text-center mb-4">Đánh giá trải nghiệm</h3>
                <form id="feedbackForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">CHỦ ĐỀ</label>
                        <select class="form-select" id="feedbackCategory" style="border-radius: 12px; background: #f4f6f8; border: none; padding: 12px;">
                            <option value="">Chọn một chủ đề...</option>
                            <option value="accuracy">Độ chính xác của AI</option>
                            <option value="ui">Giao diện người dùng</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted">NHẬN XÉT</label>
                        <textarea class="form-control" id="feedbackContent" rows="4" style="border-radius: 12px; background: #f4f6f8; border: none; padding: 12px;"></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-3">
                        <button type="button" class="btn btn-link text-decoration-none fw-bold" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" onclick="submitFeedback(event)" class="btn btn-primary fw-bold" style="border-radius: 20px; padding: 10px 24px;">Gửi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            const symptomData = sessionStorage.getItem('healthGuard_SymptomDetails');
            if (!symptomData) return window.location.href = "@Url.Action("Index", "Diagnostic")";

            const parsedData = JSON.parse(symptomData);
            const requestPayload = {
                selectedSymptoms: parsedData.map(s => ({ symptomId: parseInt(s.id), intensity: s.intensity, duration: s.duration }))
            };

            try {
                const response = await fetch('@Url.Content("~/api/patient/diagnose")', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(requestPayload)
                });

                // 🔥 ĐÃ FIX: Chặn lỗi ngầm, ép in ra màn hình
                if (!response.ok) {
                    const err = await response.json();
                    throw new Error(err.message || "Lỗi xử lý từ máy chủ AI Python.");
                }

                const apiResult = await response.json();

                document.getElementById('loadingStatus').style.display = "none";
                document.getElementById('resultWrapper').style.display = "block";

                const diagnosesList = apiResult.diagnoses || [];

                if(diagnosesList.length > 0) {
                    const top1 = diagnosesList[0];

                    document.getElementById('primaryDiseaseName').innerText = top1.diseaseName;
                    document.getElementById('primaryProbability').innerText = top1.probability + "%";
                    document.getElementById('primaryDesc').innerText = top1.description || "Phân tích bệnh lý dựa trên triệu chứng lâm sàng.";
                    document.getElementById('primaryTreatment').innerText = top1.treatment || "Thực hiện theo chỉ dẫn của bác sĩ.";

                    const secList = document.getElementById('secondaryList');
                    secList.innerHTML = "";
                    for(let i = 1; i < diagnosesList.length; i++) {
                        const d = diagnosesList[i];
                        secList.innerHTML += `
                            <div class="secondary-card">
                                <div class="sec-header">
                                    <h3 class="sec-title"><i class="bi bi-info-circle text-muted"></i> ${d.diseaseName}</h3>
                                    <span class="sec-prob">${d.probability}%</span>
                                </div>
                                <p class="sec-desc">${d.description || ""}</p>
                            </div>`;
                    }
                }
                else {
                    document.getElementById('primaryDiseaseName').innerText = "Không phát hiện rủi ro cao";
                    document.getElementById('primaryProbability').innerText = "";
                    document.getElementById('primaryDesc').innerText = "Dựa trên các triệu chứng bạn cung cấp, hệ thống AI không tìm thấy bệnh lý nào đạt ngưỡng rủi ro cảnh báo. Cơ thể bạn có thể đang ở trạng thái mệt mỏi nhẹ.";
                    document.getElementById('primaryTreatment').innerText = "Hãy nghỉ ngơi, uống đủ nước và ăn uống đầy đủ. Nếu các triệu chứng trở nên nghiêm trọng, vui lòng đến cơ sở y tế gần nhất.";

                    document.getElementById('secondaryList').innerHTML = `
                        <div class="alert alert-info border-0" style="background-color: #eff6ff; border-radius: 16px; padding: 25px;">
                            <i class="bi bi-info-circle-fill text-primary fs-4 mb-2 d-block"></i>
                            <strong class="d-block mb-1 text-dark">Thông tin bổ sung</strong>
                            <p class="text-muted mb-0" style="font-size: 0.95rem;">Hệ thống chưa ghi nhận đủ dữ liệu triệu chứng đặc hiệu để đưa ra các dự đoán bệnh lý phụ trợ.</p>
                        </div>
                    `;
                }
            } catch (error) {
                console.error("Lỗi:", error);
                document.getElementById('loadingStatus').innerHTML = `<h3 class='text-danger mt-5'><i class='bi bi-bug me-2'></i>${error.message || "Lỗi kết nối máy chủ AI."}</h3>`;
            }
        });

        async function submitFeedback(event) {
            alert("Cảm ơn phản hồi của bạn!");
            location.reload();
        }
    </script>
}