@model HealthGuard.Models.Entity.DiagnosticSession
@{
    ViewData["Title"] = "Chi tiết kết quả phân tích - HealthGuard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Sắp xếp các bệnh theo tỷ lệ phần trăm giảm dần
    var orderedResults = Model.DiagnosisResults.OrderByDescending(r => r.ProbabilityPercentage).ToList();
    var topDisease = orderedResults.FirstOrDefault();
    var otherDiseases = orderedResults.Skip(1).ToList();
}

@section Styles {
    <style>
        .page-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .wizard-header {
            margin-bottom: 30px;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 15px;
        }

        .wizard-step-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #3b82f6;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .main-title {
            font-size: 2.2rem;
            font-weight: 800;
            color: #1e293b;
            margin-top: 5px;
        }

        .sub-title {
            color: #64748b;
            font-size: 1rem;
        }

        .result-container {
            display: grid;
            grid-template-columns: 7fr 5fr;
            gap: 30px;
            margin-top: 30px;
        }

        .left-panel {
            background: white;
            border-radius: 24px;
            padding: 40px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }

        .right-panel {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .disease-name {
            font-size: 2.2rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 10px;
        }

        .percentage-large {
            font-size: 3rem;
            font-weight: 800;
            color: #1e3a8a;
            margin-bottom: 25px;
        }

        .disease-desc {
            color: #475569;
            font-size: 1.1rem;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .advice-box {
            background-color: #f8fafc;
            border-left: 4px solid #3b82f6;
            padding: 20px;
            border-radius: 0 16px 16px 0;
            margin-bottom: 30px;
        }

        .advice-title {
            font-weight: 700;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            font-size: 0.95rem;
            text-transform: uppercase;
        }

        .advice-text {
            color: #475569;
            font-size: 1rem;
            line-height: 1.6;
        }

        .side-card {
            background: white;
            border-radius: 20px;
            padding: 20px;
            border: 1px solid #e2e8f0;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            position: relative;
        }

        .side-card-info {
            max-width: 75%;
        }

        .side-card-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 6px;
        }

        .side-card-desc {
            color: #64748b;
            font-size: 0.85rem;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .side-card-percentage {
            font-size: 1.25rem;
            font-weight: 800;
            color: #1e293b;
            text-align: right;
            min-width: 70px;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8rem;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 20px;
            margin-top: 10px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #f1f5f9;
            color: #334155;
            border: none;
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: 700;
            text-decoration: none;
            transition: 0.2s;
            margin-top: 20px;
        }

            .btn-back:hover {
                background: #e2e8f0;
                color: #0f172a;
            }

        @@media (max-width: 992px) {
            .result-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="page-container">
    <div class="wizard-header">
        <div class="wizard-step-title"><i class="bi bi-file-earmark-medical"></i> HỒ SƠ LỊCH SỬ • NGÀY KHÁM: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
        <h1 class="main-title">Kết quả phân tích</h1>
        <p class="sub-title">Trí tuệ nhân tạo đã hoàn tất quá trình so khớp lại bản ghi lịch sử và đánh giá các triệu chứng quá khứ của bạn.</p>
    </div>

    @if (topDisease != null && topDisease.Disease != null)
    {
        string probLabel = topDisease.ProbabilityPercentage >= 80 ? "Nguy cơ cao" : (topDisease.ProbabilityPercentage >= 50 ? "Nguy cơ trung bình" : "Nguy cơ thấp");
        string probColor = topDisease.ProbabilityPercentage >= 80 ? "#dc2626" : (topDisease.ProbabilityPercentage >= 50 ? "#d97706" : "#0284c7");
        string bgPill = topDisease.ProbabilityPercentage >= 80 ? "#fee2e2" : (topDisease.ProbabilityPercentage >= 50 ? "#fef3c7" : "#e0f2fe");

        <div class="result-container">
            <div class="left-panel">
                <h2 class="disease-name">@topDisease.Disease.DiseaseName</h2>
                <div class="percentage-large">@topDisease.ProbabilityPercentage%</div>

                <p class="disease-desc">@topDisease.Disease.Description</p>

                <div class="advice-box">
                    <div class="advice-title"><i class="bi bi-heart-pulse"></i> Hành động khuyến nghị</div>
                    <div class="advice-text">@topDisease.Disease.TreatmentAdvice</div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <span style="font-size: 0.85rem; color: #94a3b8;"><i class="bi bi-robot"></i> Mô hình chẩn đoán: Logistic Regression</span>
                    <a href="@Url.Action("History", "Diagnostic")" class="btn-back"><i class="bi bi-arrow-left"></i> Quay lại lịch sử</a>
                </div>
            </div>

            <div class="right-panel">
                <div class="side-card" style="border-left: 4px solid @probColor">
                    <div class="side-card-info">
                        <h3 class="side-card-title">@topDisease.Disease.DiseaseName</h3>
                        <p class="side-card-desc">@topDisease.Disease.Description</p>
                        <div class="status-pill" style="background-color: @bgPill; color: @probColor;">
                            <span class="status-dot" style="background-color: @probColor;"></span> @probLabel
                        </div>
                    </div>
                    <div class="side-card-percentage" style="color: @probColor;">@topDisease.ProbabilityPercentage%</div>
                </div>

                @foreach (var other in otherDiseases)
                {
                    if (other.Disease == null) continue;
                    string oLabel = other.ProbabilityPercentage >= 80 ? "Nguy cơ cao" : (other.ProbabilityPercentage >= 50 ? "Nguy cơ trung bình" : "Nguy cơ thấp");
                    string oColor = other.ProbabilityPercentage >= 80 ? "#dc2626" : (other.ProbabilityPercentage >= 50 ? "#d97706" : "#0284c7");
                    string oBg = other.ProbabilityPercentage >= 80 ? "#fee2e2" : (other.ProbabilityPercentage >= 50 ? "#fef3c7" : "#e0f2fe");

                    <div class="side-card">
                        <div class="side-card-info">
                            <h3 class="side-card-title">@other.Disease.DiseaseName</h3>
                            <p class="side-card-desc">@other.Disease.Description</p>
                            <div class="status-pill" style="background-color: @oBg; color: @oColor;">
                                <span class="status-dot" style="background-color: @oColor;"></span> @oLabel
                            </div>
                        </div>
                        <div class="side-card-percentage" style="color: @oColor;">@other.ProbabilityPercentage%</div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="text-center p-5 bg-white rounded-3 border mt-4">
            <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
            <p class="mt-3 fw-bold">Không tìm thấy dữ liệu phân tích chi tiết của phiên này.</p>
            <a href="@Url.Action("History", "Diagnostic")" class="btn btn-primary rounded-pill px-4">Quay lại danh sách</a>
        </div>
    }
</div>