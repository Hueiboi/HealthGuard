<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - HealthGuard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-color: #2563eb;
            --bg-color: #f8fafc;
            --sidebar-bg: #ffffff;
            --text-dark: #1e293b;
            --text-muted: #64748b;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: var(--bg-color);
            margin: 0;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            width: 250px;
            background-color: var(--sidebar-bg);
            border-right: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            padding: 20px 0;
            z-index: 20;
        }

        .brand-logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary-color);
            padding: 0 25px 30px;
            text-decoration: none;
        }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex: 1;
        }

        .nav-item {
            padding: 5px 20px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            color: var(--text-muted);
            text-decoration: none;
            padding: 12px 15px;
            border-radius: 12px;
            font-weight: 500;
            transition: 0.2s;
            font-size: 0.95rem;
        }

            .nav-link i {
                margin-right: 12px;
                font-size: 1.2rem;
            }

            .nav-link:hover {
                background-color: #f1f5f9;
                color: var(--text-dark);
            }

            .nav-link.active {
                background-color: #eff6ff;
                color: var(--primary-color);
            }

        .sidebar-footer {
            padding: 20px;
        }

        .btn-health-tips {
            width: 100%;
            background-color: #eff6ff;
            color: var(--primary-color);
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: 0.2s;
        }

            .btn-health-tips:hover {
                background-color: #dbeafe;
            }

        /* --- MAIN CONTENT & HEADER --- */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            background-color: var(--bg-color);
            overflow-y: auto;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 40px;
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .header-navigation {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-muted);
        }

            .nav-breadcrumb a {
                text-decoration: none;
                color: var(--text-muted);
                transition: 0.2s;
            }

                .nav-breadcrumb a:hover {
                    color: var(--primary-color);
                }

            .nav-breadcrumb i.separator {
                font-size: 0.7rem;
                color: #cbd5e1;
            }

            .nav-breadcrumb .current {
                color: var(--text-dark);
                font-weight: 700;
            }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .btn-wizard-top {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
        }

        .icon-btn {
            font-size: 1.2rem;
            color: var(--text-muted);
            cursor: pointer;
            transition: 0.2s;
        }

            .icon-btn:hover {
                color: var(--primary-color);
            }

        .avatar-top {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: #1abc9c;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            overflow: hidden;
        }

        .content-wrapper {
            padding: 35px 40px;
            flex: 1;
        }

        /* Hiệu ứng nảy chấm đỏ */
        @@keyframes pulse-red {
            0%

        {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7);
        }

        70% {
            transform: scale(1);
            box-shadow: 0 0 0 6px rgba(220, 38, 38, 0);
        }

        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(220, 38, 38, 0);
        }

        }

        .notif-badge {
            width: 10px;
            height: 10px;
            animation: pulse-red 2s infinite;
        }

        /* Custom thanh cuộn thông báo */
        .notif-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .notif-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        @RenderSection("Styles", required: false)
    </style>
</head>
<body>

    @if (TempData["Success"] != null)
    {
        <script>
            window.serverNotification = "@Html.Raw(TempData["Success"])";
        </script>
    }

    <aside class="sidebar">
        <a asp-controller="Home" asp-action="Index" class="brand-logo">HealthGuard</a>
        <ul class="nav-menu">
            <li class="nav-item"><a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"><i class="bi bi-grid-1x2"></i> Tổng quan</a></li>
            <li class="nav-item"><a asp-controller="Patient" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Patient" ? "active" : "")"><i class="bi bi-file-earmark-medical"></i> Hồ sơ y tế</a></li>
            <li class="nav-item"><a asp-controller="Diagnostic" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Diagnostic" ? "active" : "")"><i class="bi bi-cpu"></i> Chẩn đoán AI</a></li>
            <li class="nav-item"><a asp-controller="Handbook" asp-action="Index" class="nav-link"><i class="bi bi-journal-medical"></i> Cẩm nang y khoa</a></li>
            <li class="nav-item"><a asp-controller="PatientFeedback" asp-action="Messages" class="nav-link"><i class="bi bi-chat-dots"></i> Tin nhắn</a></li>
        </ul>

        <div class="sidebar-footer">
            <button id="btnRandomTip" class="btn-health-tips">View Health Tips</button>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-header">
            <div class="header-navigation">
                <div class="nav-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">HealthGuard</a>
                    <i class="bi bi-chevron-right separator"></i>
                    <span class="current">@ViewData["Title"]</span>
                </div>
                <span style="color: #cbd5e1; margin: 0 15px;">|</span>
                <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">
                    <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dddd, dd/MM/yyyy")
                </div>
            </div>

            <div class="header-actions">
                <a asp-controller="Diagnostic" asp-action="Index" class="btn-wizard-top">
                    <i class="bi bi-stars"></i> AI Diagnosis Wizard
                </a>

                <div class="dropdown">
                    <div class="position-relative icon-btn mt-1" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
                        <i class="bi bi-bell"></i>
                        <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle bg-danger border border-light rounded-circle notif-badge" style="display: none;"></span>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg" style="border-radius: 16px; border: 1px solid #e2e8f0; margin-top: 15px; width: 340px; padding: 0; overflow: hidden;">
                        <li class="px-3 py-3 border-bottom d-flex justify-content-between align-items-center" style="background-color: #f8fafc;">
                            <span class="fw-bold text-dark" style="font-size: 1rem;"><i class="bi bi-bell-fill text-primary me-2"></i>Thông báo</span>
                            <a href="javascript:void(0)" onclick="markAllAsRead()" style="font-size: 0.8rem; text-decoration: none; color: var(--primary-color); font-weight: 600;">Đánh dấu đã đọc</a>
                        </li>

                        <div id="notificationList" class="notif-scroll" style="max-height: 320px; overflow-y: auto;">
                        </div>

                        <li class="px-3 py-2 text-center border-top bg-light">
                            <a href="#" style="font-size: 0.85rem; text-decoration: none; color: var(--text-muted); font-weight: 600;">Xem tất cả lịch sử</a>
                        </li>
                    </ul>
                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <div class="avatar-top" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer; user-select: none;">
                            @{
                                var avatarClaim = User.FindFirst("AvatarUrl")?.Value;
                            }
                            @if (!string.IsNullOrEmpty(avatarClaim))
                            {
                                <img src="@avatarClaim" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                            }
                            else
                            {
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                            }
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow" style="border-radius: 12px; border: 1px solid #e2e8f0; margin-top: 10px;">
                            <li class="px-3 py-2 border-bottom mb-1">
                                <p class="mb-0 fw-bold text-dark">@User.Identity.Name</p>
                                <small class="text-muted">Bệnh nhân</small>
                            </li>
                            <li><a class="dropdown-item py-2" asp-controller="Patient" asp-action="Index"><i class="bi bi-person me-2"></i>Hồ sơ cá nhân</a></li>
                            <li><a class="dropdown-item py-2 text-danger" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary btn-sm fw-bold" style="border-radius: 20px; padding: 6px 20px;">Đăng nhập</a>
                }
            </div>
        </header>

        <div class="content-wrapper">
            @RenderBody()
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const notifList = document.getElementById('notificationList');
            const notifBadge = document.getElementById('notifBadge');
            let unreadCount = 0;

            // Hàm gen HTML từng dòng thông báo
            function addNotification(title, message, time, icon, colorClass, isUnread) {
                // Nếu chưa đọc thì cho background xanh nhạt
                const bgClass = isUnread ? "bg-primary" : "bg-transparent";
                const bgStyle = isUnread ? "background-color: #eff6ff !important;" : "";

                const html = `
                    <li class="px-3 py-3 border-bottom notif-item position-relative" style="cursor: pointer; transition: 0.2s; ${bgStyle}">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: var(--bs-${colorClass}-bg-subtle); color: var(--bs-${colorClass}); flex-shrink: 0; font-size: 1.2rem;">
                                <i class="bi ${icon}"></i>
                            </div>
                            <div style="flex: 1;">
                                <p class="mb-1 fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.2;">${title}</p>
                                <span class="text-muted d-block mb-1" style="font-size: 0.8rem; line-height: 1.4;">${message}</span>
                                <div style="font-size: 0.7rem; color: #94a3b8;"><i class="bi bi-clock me-1"></i>${time}</div>
                            </div>
                            ${isUnread ? '<span class="position-absolute notif-dot" style="width: 8px; height: 8px; background: var(--primary-color); border-radius: 50%; right: 15px; top: 15px;"></span>' : ''}
                        </div>
                    </li>
                `;
                notifList.insertAdjacentHTML('afterbegin', html);
                if (isUnread) unreadCount++;
            }

            // 1. Dữ liệu thông báo giả lập (Các loại khác nhau)
            addNotification("Cẩm nang y khoa", "Khám phá ngay 20 bệnh lý hô hấp mới được AI cập nhật.", "2 ngày trước", "bi-journal-medical", "info", false);
            addNotification("Nhắc nhở định kỳ", "Hãy nhớ uống đủ 2 lít nước hôm nay nhé!", "1 ngày trước", "bi-droplet-fill", "primary", false);

            // 2. Bắt thông báo THỰC TẾ từ C# (Ví dụ: Cập nhật hồ sơ thành công)
            if (window.serverNotification && window.serverNotification !== '') {
                addNotification("Thao tác thành công", window.serverNotification, "Vừa xong", "bi-check-circle-fill", "success", true);
            } else {
                // Nếu không có hành động gì, cứ giả vờ có 1 tin nhắn chào mừng mới cho xịn
                addNotification("Chào mừng trở lại", "Hệ thống AI chẩn đoán luôn sẵn sàng hỗ trợ bạn.", "Vừa xong", "bi-stars", "warning", true);
            }

            // 3. Hiển thị chấm đỏ nếu có tin chưa đọc
            if (unreadCount > 0) {
                notifBadge.style.display = "block";
            }
        });

        // Hàm Đánh dấu đã đọc
        function markAllAsRead() {
            // Xóa màu nền xanh
            document.querySelectorAll('.notif-item').forEach(item => {
                item.style.backgroundColor = "transparent";
                item.style.setProperty("background-color", "transparent", "important");
            });
            // Xóa các dấu chấm phụ bên trong thẻ
            document.querySelectorAll('.notif-dot').forEach(dot => dot.remove());
            // Tắt hiệu ứng chấm đỏ ngoài chuông
            document.getElementById('notifBadge').style.display = "none";
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>