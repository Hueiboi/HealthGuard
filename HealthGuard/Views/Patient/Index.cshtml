@model HealthGuard.Models.Dto.PatientProfileDto
@{
    ViewData["Title"] = "Hồ sơ Bệnh nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var bmiValue = (Model.Weight > 0 && Model.Height > 0)
                   ? Math.Round(Model.Weight / Math.Pow(Model.Height / 100.0, 2), 1)
                   : 0;

    string bmiStatus = "Bình thường";
    if (bmiValue > 0 && bmiValue < 18.5) bmiStatus = "Gầy";
    else if (bmiValue >= 25) bmiStatus = "Thừa cân (Overweight)";
    else if (bmiValue == 0) bmiStatus = "Chưa có dữ liệu";
}

@section Styles {
    <style>
        .page-title {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 5px;
            color: var(--text-dark);
        }

        .page-subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin: 0;
        }

        .btn-cancel {
            color: var(--primary-color);
            font-weight: 700;
            text-decoration: none;
            padding: 10px 20px;
            font-size: 0.9rem;
            border: none;
            background: transparent;
            cursor: pointer;
        }

        .btn-save {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: 0.2s;
        }

            .btn-save:hover {
                background-color: #155eef;
                color: white;
                box-shadow: 0 4px 10px rgba(37,99,235,0.2);
                transform: translateY(-1px);
            }

        .container-custom {
            padding: 30px 40px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .profile-card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            margin-bottom: 30px;
            position: relative;
            overflow: hidden;
            border: 1px solid #e2e8f0;
        }

        .border-accent-blue::before {
            content: '';
            position: absolute;
            left: 0;
            top: 30px;
            bottom: 30px;
            width: 4px;
            background-color: #3b82f6;
            border-radius: 0 4px 4px 0;
        }

        .border-accent-orange::before {
            content: '';
            position: absolute;
            left: 0;
            top: 30px;
            bottom: 30px;
            width: 4px;
            background-color: #d97706;
            border-radius: 0 4px 4px 0;
        }

        .card-header-custom {
            display: flex;
            align-items: center;
            margin-bottom: 25px;
            gap: 15px;
        }

        .header-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .icon-blue {
            background: #eff6ff;
            color: #2563eb;
        }

        .icon-orange {
            background: #fffbeb;
            color: #d97706;
        }

        .card-title-custom {
            font-size: 1.1rem;
            font-weight: 700;
            margin: 0;
            color: var(--text-dark);
        }

        .form-label-custom {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            display: block;
        }

        .form-control-custom {
            width: 100%;
            background-color: #f1f5f9;
            border: 1px solid transparent;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
            color: var(--text-dark);
            font-weight: 500;
            transition: 0.2s;
        }

            .form-control-custom:focus {
                background-color: white;
                border-color: #cbd5e1;
                outline: none;
                box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.05);
            }

        select.form-control-custom {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 1rem center;
            background-size: 1em;
            cursor: pointer;
        }

        .bio-input-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .bio-input-group .form-control-custom {
                width: 80px;
                text-align: center;
            }

        .bmi-container {
            background: #f1f5f9;
            border-radius: 16px;
            padding: 20px;
            margin-top: 25px;
        }

        .bmi-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .bmi-value {
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--primary-color);
            transition: color 0.3s;
        }

        .bmi-bar-bg {
            height: 6px;
            background: #cbd5e1;
            border-radius: 3px;
            position: relative;
            overflow: hidden;
            margin-bottom: 8px;
        }

        .bmi-bar-fill {
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            background: #334155;
            border-radius: 3px;
            transition: width 0.5s ease, background-color 0.5s ease;
        }

        .complete-card {
            background: #f0f4ff;
            border-radius: 16px;
            padding: 25px;
            border: 1px solid #e0e7ff;
        }

        .complete-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 15px;
        }

        .progress-custom {
            height: 8px;
            border-radius: 4px;
            background: #e0e7ff;
            margin-bottom: 15px;
            overflow: hidden;
        }

        .progress-bar-custom {
            background: var(--primary-color);
            border-radius: 4px;
            width: 0%;
            height: 100%;
            transition: width 0.5s ease, background-color 0.5s ease;
        }

        .avatar-preview {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .cursor-pointer {
            cursor: pointer;
        }
    </style>
}

<div class="container-custom">
    <form asp-controller="Patient" asp-action="UpdateProfile" method="post" id="profileForm">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="AvatarUrl" id="AvatarUrlHidden" />

        <div class="d-flex justify-content-between align-items-center mb-4 w-100">
            <div>
                <h1 class="page-title mb-1">Hồ sơ Bệnh nhân</h1>
                <p class="page-subtitle text-muted mb-0">Quản lý thông tin cá nhân và tiền sử y tế của bạn.</p>
            </div>

            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn-cancel" onclick="window.history.back()">HỦY BỎ</button>
                <button type="submit" class="btn-save">LƯU THAY ĐỔI</button>
            </div>
        </div>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4" style="border-radius: 12px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="profile-card border-accent-blue">
                    <div class="card-header-custom mb-4">
                        <div class="header-icon icon-blue"><i class="bi bi-person"></i></div>
                        <h2 class="card-title-custom">Thông tin cá nhân</h2>
                    </div>

                    <div class="d-flex align-items-center mb-4 gap-3 bg-light p-3 rounded-4 border border-light">
                        <div class="position-relative">
                            <img id="avatarPreview" src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(Model.FullName ?? "U")}&background=e2eafc&color=2563eb" : Model.AvatarUrl)" class="avatar-preview" alt="Avatar">

                            <label for="avatarInput" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center cursor-pointer shadow" style="width: 26px; height: 26px; border: 2px solid white; margin-right: -4px; margin-bottom: -4px;">
                                <i class="bi bi-camera-fill" style="font-size: 0.75rem;"></i>
                            </label>
                            <input type="file" id="avatarInput" class="d-none" accept="image/jpeg, image/png, image/jpg">
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold" style="font-size: 0.95rem;">Ảnh đại diện</h6>
                            <p class="text-muted mb-0" style="font-size: 0.8rem;">Định dạng JPG, PNG. Tối đa 2MB.</p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-custom" asp-for="FullName">HỌ VÀ TÊN</label>
                            <input type="text" asp-for="FullName" class="form-control-custom progress-trigger" placeholder="Nhập họ tên">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom" asp-for="DateOfBirth">NGÀY SINH</label>
                            <input type="date" asp-for="DateOfBirth" class="form-control-custom progress-trigger">
                        </div>
                        <div class="col-12">
                            <label class="form-label-custom" asp-for="Email">ĐỊA CHỈ EMAIL</label>
                            <input type="email" asp-for="Email" class="form-control-custom" readonly style="background-color: #e2e8f0; cursor: not-allowed;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom" asp-for="PhoneNumber">SỐ ĐIỆN THOẠI</label>
                            <input type="tel" asp-for="PhoneNumber" class="form-control-custom progress-trigger">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom" asp-for="Gender">GIỚI TÍNH</label>
                            <select asp-for="Gender" class="form-control-custom progress-trigger">
                                <option value="">Chọn...</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom" asp-for="BloodType">NHÓM MÁU</label>
                            <select asp-for="BloodType" class="form-control-custom progress-trigger">
                                <option value="">Chọn...</option>
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="AB">AB</option>
                                <option value="O">O</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="profile-card border-accent-blue">
                    <div class="card-header-custom">
                        <div class="header-icon icon-blue"><i class="bi bi-clock-history"></i></div>
                        <h2 class="card-title-custom">Tiền sử bệnh lý</h2>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-custom" asp-for="MedicalHistory">MÔ TẢ TIỀN SỬ BỆNH</label>
                        <textarea asp-for="MedicalHistory" class="form-control-custom progress-trigger" rows="3" placeholder="Ví dụ: Cao huyết áp, hen suyễn, bệnh tim mạch..."></textarea>
                    </div>

                    <div>
                        <label class="form-label-custom" asp-for="Allergies">DỊ ỨNG & MẪN CẢM</label>
                        <textarea asp-for="Allergies" class="form-control-custom progress-trigger" rows="2" placeholder="Ví dụ: Dị ứng hải sản, phấn hoa, kháng sinh Penicillin..."></textarea>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="profile-card border-accent-orange">
                    <div class="card-header-custom">
                        <div class="header-icon icon-orange"><i class="bi bi-clipboard2-pulse"></i></div>
                        <h2 class="card-title-custom">Chỉ số sinh tồn</h2>
                    </div>

                    <div class="d-flex gap-5 mb-2">
                        <div>
                            <label class="form-label-custom" asp-for="Height">CHIỀU CAO (CM)</label>
                            <div class="bio-input-group">
                                <input type="number" step="0.1" asp-for="Height" class="form-control-custom progress-trigger bmi-trigger">
                                <span class="bio-unit fw-bold text-muted">cm</span>
                            </div>
                        </div>
                        <div>
                            <label class="form-label-custom" asp-for="Weight">CÂN NẶNG (KG)</label>
                            <div class="bio-input-group">
                                <input type="number" step="0.1" asp-for="Weight" class="form-control-custom progress-trigger bmi-trigger">
                                <span class="bio-unit fw-bold text-muted">kg</span>
                            </div>
                        </div>
                    </div>

                    <div class="bmi-container">
                        <div class="bmi-header">
                            <span class="bmi-title fw-bold text-dark">Chỉ số BMI của bạn</span>
                            <span class="bmi-value" id="bmiScore">@bmiValue</span>
                        </div>
                        <div class="bmi-bar-bg">
                            <div class="bmi-bar-fill" id="bmiFill" style="width: 0%;"></div>
                        </div>
                        <div class="bmi-status fw-medium text-secondary" id="bmiStatusText" style="font-size: 0.9rem;">Trạng thái: @bmiStatus</div>
                    </div>
                </div>

                <div class="complete-card">
                    <div class="complete-header">
                        <div>
                            <i class="bi bi-shield-check text-primary fs-4 me-2"></i>
                            <span>Mức độ hoàn thiện hồ sơ</span>
                        </div>
                        <span id="profileProgressText" class="fs-5 text-primary fw-bolder">0%</span>
                    </div>
                    <div class="progress-custom">
                        <div class="progress-bar-custom" id="profileProgressBar" style="width: 0%;"></div>
                    </div>
                    <p class="complete-desc text-muted mb-0" id="profileProgressMessage" style="font-size: 0.9rem;">Đang đánh giá hồ sơ...</p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // 1. Tải ảnh Avatar
        document.getElementById('avatarInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                if(file.size > 2 * 1024 * 1024) {
                    alert('Kích thước ảnh vượt quá 2MB. Vui lòng chọn ảnh nhẹ hơn.');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(event) {
                    document.getElementById('avatarPreview').src = event.target.result;
                    document.getElementById('AvatarUrlHidden').value = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        document.addEventListener("DOMContentLoaded", function () {

            // 2. TÍNH CHỈ SỐ BMI ĐỘNG
            const heightInput = document.getElementById('Height');
            const weightInput = document.getElementById('Weight');
            const bmiScore = document.getElementById('bmiScore');
            const bmiFill = document.getElementById('bmiFill');
            const bmiStatusText = document.getElementById('bmiStatusText');

            function calculateBMI() {
                let h = parseFloat(heightInput.value);
                let w = parseFloat(weightInput.value);

                if (h > 0 && w > 0) {
                    let heightInMeters = h / 100;
                    let bmi = (w / (heightInMeters * heightInMeters)).toFixed(1);
                    bmiScore.innerText = bmi;

                    let status = "";
                    let color = "";

                    if (bmi < 18.5) { status = "Gầy (Thiếu cân)"; color = "#3b82f6"; }
                    else if (bmi < 25) { status = "Bình thường"; color = "#10b981"; }
                    else if (bmi < 30) { status = "Thừa cân"; color = "#f59e0b"; }
                    else { status = "Béo phì"; color = "#ef4444"; }

                    bmiStatusText.innerText = "Trạng thái: " + status;
                    bmiFill.style.width = Math.min(bmi * 3, 100) + "%";
                    bmiFill.style.backgroundColor = color;
                    bmiScore.style.color = color;
                } else {
                    bmiScore.innerText = "0";
                    bmiStatusText.innerText = "Trạng thái: Chưa có dữ liệu";
                    bmiFill.style.width = "0%";
                    bmiScore.style.color = "var(--primary-color)";
                }
            }

            document.querySelectorAll('.bmi-trigger').forEach(input => {
                input.addEventListener('input', calculateBMI);
            });
            calculateBMI();

            // 3. PROGRESS BAR HỒ SƠ ĐỘNG
            const progressTriggers = document.querySelectorAll('.progress-trigger');
            const progressBar = document.getElementById('profileProgressBar');
            const progressText = document.getElementById('profileProgressText');
            const progressMessage = document.getElementById('profileProgressMessage');

            function calculateProfileProgress() {
                const fields = [
                    document.getElementById('FullName').value,
                    document.getElementById('DateOfBirth').value,
                    document.getElementById('PhoneNumber').value,
                    document.getElementById('Gender').value,
                    document.getElementById('BloodType').value,
                    document.getElementById('Height').value,
                    document.getElementById('Weight').value,
                    document.getElementById('MedicalHistory').value,
                    document.getElementById('Allergies').value
                ];

                let filledCount = fields.filter(val => val && val.trim() !== '' && val !== '0').length;
                let percentage = Math.round((filledCount / fields.length) * 100);

                progressBar.style.width = percentage + '%';
                progressText.innerText = percentage + '%';

                if (percentage <= 30) {
                    progressBar.style.backgroundColor = '#ef4444';
                    progressText.style.color = '#ef4444';
                    progressMessage.innerText = "Hồ sơ của bạn còn trống. Hãy bổ sung thông tin để hệ thống AI hiểu bạn hơn nhé!";
                } else if (percentage < 80) {
                    progressBar.style.backgroundColor = '#f59e0b';
                    progressText.style.color = '#f59e0b';
                    progressMessage.innerText = "Bạn đã điền được một nửa chặng đường. Chỉ thêm chút thông tin nữa thôi là hoàn thiện.";
                } else if (percentage < 100) {
                    progressBar.style.backgroundColor = '#3b82f6';
                    progressText.style.color = '#3b82f6';
                    progressMessage.innerText = "Hồ sơ của bạn đã cơ bản hoàn thiện. Đừng quên cập nhật tiền sử và dị ứng nếu có.";
                } else {
                    progressBar.style.backgroundColor = '#10b981';
                    progressText.style.color = '#10b981';
                    progressMessage.innerText = "Tuyệt vời! Hồ sơ của bạn đã hoàn thiện 100%. Thông tin này giúp AI chẩn đoán cực kỳ chính xác.";
                }
            }

            progressTriggers.forEach(input => {
                input.addEventListener('input', calculateProfileProgress);
                input.addEventListener('change', calculateProfileProgress);
            });
            calculateProfileProgress();
        });
    </script>
}